# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The web build (T-064). `flutter build web` writes build/web/ (ignored above);
# tools/build-app.sh copies it to ../app-web/, which is what Pages serves. An
# earlier build script copied it into this folder instead: these keep any such
# copy out of git, so only sources, assets and platform files are tracked here.
/.web-build-files
/assets/AssetManifest*
/assets/FontManifest.json
/assets/NOTICES
/assets/assets/
/assets/packages/
/assets/shaders/
/assets/fonts/MaterialIcons-Regular.otf
/assets/fonts/fallback/
/canvaskit/
/icons/
/favicon.png
/flutter.js
/flutter_bootstrap.js
/flutter_service_worker.js
/main.dart.js
/manifest.json
/version.json
